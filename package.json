{
  "name": "stf-workspace",
  "private": true,
  "type": "module",
  "description": "Workspace root for the STF specification and reference implementations",
  "scripts": {
    "conformance": "./scripts/check_conformance.sh",
    "conformance:js": "node tests/conformance/run_js.mjs",
    "test:js": "node --test \"ref-impl/js/*.test.ts\"",
    "test:rust": "cargo test --manifest-path ref-impl/rust/Cargo.toml",
    "test:python": "python3 -m unittest discover -s tests -t . --start-directory ref-impl/python/tests",
    "test:go": "cd ref-impl/go && go test ./...",
    "corpus": "python3 tests/conformance/build_corpus.py",
    "test:vscode": "npm --prefix vscode-stf test",
    "shots": "node website/scripts/shots.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.0"
  }
}
