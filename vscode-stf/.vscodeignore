# Build inputs. `out/extension.js` is what ships; the TypeScript that produced it is not.
src/**
tsconfig.json
**/*.ts
**/*.map
tests/**
.vscode-test/**
.gitignore

# Docs, except the one the marketplace renders.
*.md
!README.md

# `node_modules` is deliberately not ignored. `vscode-languageclient` is a runtime
# dependency and vsce prunes devDependencies itself, so excluding the directory would
# package an extension that cannot start.
