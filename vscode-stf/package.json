{
  "name": "stf",
  "displayName": "STF Support",
  "description": "STF (Structured Text Format) syntax highlighting and validation",
  "version": "1.0.0",
  "publisher": "opentf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Tech-Foundation/DTXT.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "stf",
    "data",
    "format",
    "serialization"
  ],
  "activationEvents": [
    "onLanguage:stf"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "stf",
        "aliases": [
          "STF",
          "Structured Text Format"
        ],
        "extensions": [
          ".stf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "stf",
        "scopeName": "source.stf",
        "path": "./syntaxes/stf.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "license": "ISC",
  "type": "commonjs"
}
